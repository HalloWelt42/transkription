# Vorschaltdienst wie bei Kiste und Kellerwolke: TLS mit dem Blattzertifikat der Hausstelle und HTTP/2 auf 8631, die
# App dahinter ohne TLS und von außen nicht erreichbar. Beim Zugriff per IP steht kein Servername im Handschlag, darum
# default_sni: der Name transkription.local steht in jedem Zertifikat der App (das Ausrollen nimmt ihn immer auf), so
# braucht der Vorschaltdienst keine Heimadresse. Kein HSTS: unter einem Rechnernamen würde es alle Ports des Pi auf
# HTTPS zwingen.
{
	admin off
	auto_https off
	default_sni transkription.local
}

:8631 {
	tls /zertifikate/transkription.pem /zertifikate/transkription-schluessel.pem
	# Zugriffe ins Protokoll des Containers (docker compose logs vorne): zeigt, was Geräte wirklich abfragen
	log {
		output stdout
		format json
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
	# Ereignisströme, Ton und Hochladen gehen ungepuffert durch
	reverse_proxy transkription:8630 {
		flush_interval -1
	}
}
