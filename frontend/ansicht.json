      "wechsel": [
        { "klick": ".seiten-kopf .knopf:has(.fa-pen), .knopfzeile .rund[aria-label=Bearbeiten]", "warten_ms": 800 },
        { "klick": "[data-i='1'] .beitrag, [data-i='1'] .t-beitrag", "warten_ms": 500 }
      ] },
    { "name": "sprecher", "pfad": "/sprecher" },
    { "name": "auftraege", "pfad": "/auftraege" },
