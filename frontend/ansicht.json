      "wechsel": [
        { "klick": ".seiten-kopf .knopf:has(.fa-circle-dot), .t-aufnehmen .rot", "warten_ms": 2500 },
        { "klick": ".rek-leiste .pause", "fest": [".rek-leiste", ".rek-symbole", ".rek-zeit"] },
        { "klick": ".rek-symbol[aria-label='Live-Mitschrift']", "fest": [".rek-leiste", ".rek-symbole"] },
